diff --git a/mmCoreAndDevices/DeviceAdapters/Makefile.am b/mmCoreAndDevices/DeviceAdapters/Makefile.am
index 1234567..89abcde 100644
--- a/mmCoreAndDevices/DeviceAdapters/Makefile.am
+++ b/mmCoreAndDevices/DeviceAdapters/Makefile.am
@@ -5,7 +5,7 @@
 # Order matters: The adapters listed earlier are loaded first by DeviceManager
 # (This list is processed by configure.ac, which adds them to build configuration)
 SUBDIRS = DemoCamera \
-	SerialManager \
+	# SerialManager DISABLED: Boost Asio io_service incompatibility on macOS ARM64 \
 	# SerialManager uses deprecated boost::asio::io_service API that was replaced
 	# by boost::asio::io_context in Boost 1.66+. This causes template
 	# resolution errors on modern macOS with Homebrew Boost.
 	# Since SerialManager is non-essential for most camera setups, we disable it.
         BlueboxOptics_niji \
 	         $(DEMO_ADAPTERS) \
 	         $(PLUGIN_ADAPTERS) \
 	         $(PROP_ADAPTERS)

diff --git a/mmCoreAndDevices/DeviceAdapters/configure.ac b/mmCoreAndDevices/DeviceAdapters/configure.ac
index 1234567..89abcde 100644
--- a/mmCoreAndDevices/DeviceAdapters/configure.ac
+++ b/mmCoreAndDevices/DeviceAdapters/configure.ac
@@ -135,7 +135,8 @@
    m4_define([PCO_UCT], [deviceadapter/PCO_UCT/Makefile.am])
    m4_define([PCO_SC2], [deviceadapter/PCO_SC2/Makefile.am])
    m4_define([PCO_USB], [deviceadapter/PCO_USB/Makefile.am])
-   m4_define([SerialManager], [deviceadapter/SerialManager/Makefile.am])
+   # m4_define([SerialManager], [deviceadapter/SerialManager/Makefile.am]) DISABLED: Boost Asio io_service incompatibility
+   # SerialManager uses deprecated boost::asio::io_service API that was replaced
+   # by boost::asio::io_context in Boost 1.66+. This causes template
+   # resolution errors on modern macOS with Homebrew Boost.
+   # Since SerialManager is non-essential for most camera setups, we disable it.
    m4_define([BlueboxOptics_niji], [deviceadapter/BlueboxOptics_niji/Makefile.am]) DISABLED: Boost lexical_cast issue
    m4_define([LeicaDMi8], [deviceadapter/LeicaDMi8/Makefile.am])
